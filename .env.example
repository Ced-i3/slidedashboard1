# Orange Pi backup service: copy to a protected .env file and keep SLIDE_DATA_DIR
# on persistent storage. Vercel also needs these SLIDE_* values as server-only
# environment variables and DATABASE_URL from its connected Postgres integration.
# Generate secrets locally; never commit the real .env or firmware secret header.
HOST=127.0.0.1
PORT=8080
SLIDE_DATA_DIR=./data

# Use different random values for these two credentials.
SLIDE_DASHBOARD_PASSWORD=replace-with-a-unique-random-password-of-at-least-20-characters
SLIDE_DEVICE_ID=SLIDE-001
SLIDE_DEVICE_TOKEN=replace-with-a-unique-random-token-of-at-least-32-characters
